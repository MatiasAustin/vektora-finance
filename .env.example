# Salin ke .env.local lalu isi dari Supabase Dashboard > Settings > API
# Buat dulu project Supabase baru, lalu jalankan supabase/schema.sql
# lalu supabase/seed.sql di SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-hanya-untuk-server-jangan-dibagikan>
