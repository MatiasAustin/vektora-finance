# Salin ke .env.local lalu isi dari Supabase Dashboard > Settings > API Keys
# Buat dulu project Supabase baru, lalu jalankan supabase/schema.sql
# lalu supabase/seed.sql di SQL Editor.
#
# Supabase sekarang pakai key BARU (anon/service_role lama sudah diganti):
# - Publishable key  (sb_publishable_...) = pengganti anon key -> isi ke
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY di bawah
# - Secret key       (sb_secret_...)      = pengganti service_role key,
#   HANYA untuk server, jangan dibagikan -> isi ke SUPABASE_SECRET_KEY
# Nama env lama (NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
# masih diterima sebagai fallback, tapi pakai nama baru saja.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
